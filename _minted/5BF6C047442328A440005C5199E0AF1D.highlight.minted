\begin{MintedVerbatim}[commandchars=\\\{\}]
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{admin\PYGZus{}required}\PYG{p}{(}\PYG{n}{vista}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Como login\PYGZus{}required, pero además exige que el usuario logueado}
\PYG{l+s+sd}{    tenga rol \PYGZdq{}admin\PYGZdq{} — para las pantallas que un empleado no debería}
\PYG{l+s+sd}{    poder ver (subir/procesar CSV, panel técnico y sus descargas).}
\PYG{l+s+sd}{    Si un empleado intenta entrar, lo manda al dashboard en vez de}
\PYG{l+s+sd}{    mostrarle la página.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n+nd}{@wraps}\PYG{p}{(}\PYG{n}{vista}\PYG{p}{)}
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{envoltura}\PYG{p}{(}\PYG{o}{*}\PYG{n}{args}\PYG{p}{,} \PYG{o}{**}\PYG{n}{kwargs}\PYG{p}{):}
        \PYG{k}{if} \PYG{l+s+s2}{\PYGZdq{}username\PYGZdq{}} \PYG{o+ow}{not} \PYG{o+ow}{in} \PYG{n}{session}\PYG{p}{:}
            \PYG{n}{flash}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Iniciá sesión para continuar.\PYGZdq{}}\PYG{p}{)}
            \PYG{k}{return} \PYG{n}{redirect}\PYG{p}{(}\PYG{n}{url\PYGZus{}for}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}auth.login\PYGZdq{}}\PYG{p}{))}
        \PYG{k}{if} \PYG{n}{session}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}rol\PYGZdq{}}\PYG{p}{)} \PYG{o}{!=} \PYG{l+s+s2}{\PYGZdq{}admin\PYGZdq{}}\PYG{p}{:}
            \PYG{n}{flash}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Esa sección es solo para el administrador.\PYGZdq{}}\PYG{p}{)}
            \PYG{k}{return} \PYG{n}{redirect}\PYG{p}{(}\PYG{n}{url\PYGZus{}for}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}main.dashboard\PYGZdq{}}\PYG{p}{))}
        \PYG{k}{return} \PYG{n}{vista}\PYG{p}{(}\PYG{o}{*}\PYG{n}{args}\PYG{p}{,} \PYG{o}{**}\PYG{n}{kwargs}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{envoltura}

\end{MintedVerbatim}
