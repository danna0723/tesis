\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Define the parameters for the XGBoost model}
\PYG{n}{params} \PYG{o}{=} \PYG{p}{\PYGZob{}}
    \PYG{l+s+s1}{\PYGZsq{}max\PYGZus{}depth\PYGZsq{}}\PYG{p}{:} \PYG{l+m+mi}{8}\PYG{p}{,}                  \PYG{c+c1}{\PYGZsh{} Maximum depth of a tree}
    \PYG{l+s+s1}{\PYGZsq{}eta\PYGZsq{}}\PYG{p}{:} \PYG{l+m+mf}{0.5}\PYG{p}{,}                      \PYG{c+c1}{\PYGZsh{} Learning rate}
    \PYG{l+s+s1}{\PYGZsq{}objective\PYGZsq{}}\PYG{p}{:} \PYG{l+s+s1}{\PYGZsq{}reg:squarederror\PYGZsq{}}  \PYG{c+c1}{\PYGZsh{} Objective function for regression}
\PYG{p}{\PYGZcb{}}
\end{MintedVerbatim}
