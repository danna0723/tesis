        \PYG{n}{modelo\PYGZus{}ols} \PYG{o}{=} \PYG{n}{sm}\PYG{o}{.}\PYG{n}{OLS}\PYG{p}{(}\PYG{n}{y\PYGZus{}train}\PYG{p}{,} \PYG{n}{X\PYGZus{}sm}\PYG{p}{)}\PYG{o}{.}\PYG{n}{fit}\PYG{p}{()}
        \PYG{n}{p\PYGZus{}valores} \PYG{o}{=} \PYG{n}{modelo\PYGZus{}ols}\PYG{o}{.}\PYG{n}{pvalues}\PYG{o}{.}\PYG{n}{drop}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}const\PYGZdq{}}\PYG{p}{)}
