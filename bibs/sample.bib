@ARTICLE{Salem2022,
author="Salem, Fathi M.",
title="Gated RNN: The Gated Recurrent Unit (GRU) RNN",
bookTitle="Recurrent Neural Networks: From Simple to Gated Architectures ",
year="2022",
publisher="Springer International Publishing",
address="Cham",
pages="85--100",
abstract="We describe the standard Gated Recurrent Unit (GRU) in recurrent neural networks (RNNs) as was originally introduced. Next, by adopting the same notations as for LSTMs in the previous chapter, we directly show how it can viewed as a reduced form of the LSTM RNNs. Then, we explore further the parameter reductions in the GRU RNNs by way of introducing five slim GRU RNNs. These slim GRU RNNs retain the network structure and systematically reduce parameters in the ``update'' and ``reset'' gates. Finally, we demonstrate in illustrative case studies the comparative performance of the standard and the slim GRU RNNs. We evaluate the standard and three slim GRU variants on MNIST and IMDB datasets and show that all these GRU RNN perform comparatively.",
isbn="978-3-030-89929-5",
doi="10.1007/978-3-030-89929-5_5",
url="https://doi.org/10.1007/978-3-030-89929-5_5"
}

